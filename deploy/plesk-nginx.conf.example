# Add in the SELECTED subdomain's Plesk Apache & nginx settings.
# Disable "Proxy mode" only for that new subdomain, keep nginx enabled.
# Do not edit Plesk's global nginx config or other domains.
# Set a valid Let's Encrypt certificate in Plesk first.
location / {
    proxy_pass http://127.0.0.1:3210;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 300s;
    client_max_body_size 140m;
}
